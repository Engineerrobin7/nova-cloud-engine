android_app {
    name: "NovaPrivacyCenter",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx-constraintlayout_constraintlayout",
        "androidx.recyclerview_recyclerview",
    ],
    optimize: {
        enabled: false,
    },
}
